  events:
  - id: EV_SALE
    headline: CheapCart announces a sale
    summary: 20% off CheapCart packages for two days.
    details: A neighbourhood promotion lowers package prices at CheapCart. The original
      price remains visible beside the effective price. Other active price effects
      can combine with this sale.
    minDay: 2
    maxDay: -1
    durationDays: 2
    weight: 1
