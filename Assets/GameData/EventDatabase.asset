      value: 1.5
  - id: EV_CLOSED
    headline: Verdant & Co. closes for maintenance
    summary: The store is closed today. Pantry food is unaffected.
    details: Scheduled maintenance closes Verdant & Co. for the day. You can still
      use ingredients already in your pantry. The store reopens tomorrow; another
      accessible store remains available.
    minDay: 2
    maxDay: -1
    durationDays: 1
    weight: 1
    image: {fileID: 21300000, guid: 927909a3902d09741b64d2196988524c, type: 3}
    notificationAudio: {fileID: 0}
    detailAudio: {fileID: 0}
