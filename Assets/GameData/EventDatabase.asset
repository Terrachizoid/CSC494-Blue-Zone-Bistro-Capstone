      targetId: S002
      operation: 1
      value: 0.8
  - id: EV_OATS
    headline: Oats go viral
    summary: Oat prices rise 50% across stores today.
    details: A fictional online trend has increased demand for rolled oats. All offers
      for rolled oats cost more today. This popularity story is not evidence of a
      new health benefit; food classifications and ingredient appeal are unchanged.
    minDay: 2
    maxDay: -1
    durationDays: 1
    weight: 1
    image: {fileID: 21300000, guid: bcc1f242ed4a412e83016f2743b95cae, type: 3}
