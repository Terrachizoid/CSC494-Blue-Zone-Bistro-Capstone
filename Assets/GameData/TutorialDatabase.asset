%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b360da9bf94d30246b40adae73f848a5, type: 3}
  m_Name: TutorialDatabase
  m_EditorClassIdentifier: Assembly-CSharp::TutorialDatabase
  tutorials:
  - id: T_SHOPPING
    triggerFlag: tutorial.shopping_available
    behaviourId: Shopping
    priority: 80
    activationPhase: Market
    completionFlags:
    - tutorial.shopping_lesson_complete
    steps:
    - stepId: shop
      text: Welcome to your bistro! Your first dish will be {recipe}. You need at
        least {requirements}. Explore the stores and shelves, then drag packages
        into your cart. You may buy extras, but checkout must be affordable and leave
        you enough ingredients for this dish. Open the cart to remove packages. Pantry
        and Menu remain available.
  - id: T_SORTING
    triggerFlag: tutorial.sorting_available
    behaviourId: TextOnly
    priority: 90
    activationPhase: FoodSorting
    completionFlags:
    - tutorial.sorting_lesson_complete
    steps:
    - stepId: explain
      text: 'Before cooking, sort the new foods into Green, Yellow or Red. These
        are the game''s Traffic Light groups: Green is the everyday foundation, Yellow
        is for moderation, and Red is for occasional choices. Flip cards to inspect
        ingredients. Correct answers earn a refund on this checkout: higher accuracy
        gives a larger refund, and all correct earns up to {maxDiscount} back. You
        can rearrange cards before submitting. There is no retry after submission;
        a wrong food can return on a later purchase.'
  - id: T_COOKING
    triggerFlag: tutorial.cooking_available
    behaviourId: FirstMeal
    priority: 70
    activationPhase: Service
    completionFlags:
    - tutorial.cooking_lesson_complete
    steps:
    - stepId: choose
      text: Let's cook the ingredients you prepared. Choose {recipe} for this first
        lesson. Other recipes will be available after the lesson. You can still inspect
        your pantry or return to the main menu.
    - stepId: build
      text: Drag one serving at a time into the recipe slots for {recipe}. Required
        slots need the exact category and count. Optional slots may stay empty, or
        be filled exactly. A red rim means something needs attention. Open a slot
        to drag a serving back out. Review the dish whenever you like; this first
        lesson requires a successful recipe before you can confirm serving.
    - stepId: feedback
      text: 'Your first recipe is built! You used {ingredients}. This dish changed
        health by {healthDelta} and covered these Daily Dozen groups: {dailyDozen}.
        In this game, Green servings and the Daily Dozen groups they cover contribute
        to health. Different groups add variety; repeating the same group does not
        add another coverage bonus. Positive health gains per dish are capped. Aim
        for variety within the recipe''s slots, rather than piling on extra servings.
        From now on, you may also serve imperfect recipes and face their consequences.'
  - id: T_CRASH
    triggerFlag: tutorial.first_crash_dialogue_completed
    behaviourId: TextOnly
    priority: 100
    activationPhase: Service
    completionFlags:
    - tutorial.rush_crash_lesson_complete
    steps:
    - stepId: explain
      text: 'You have now heard both sides of a rush and crash. A brief lift can
        feel encouraging, yet it may not last. Watch the customer''s experience over
        time. Here, rush/crash is visual and dialogue feedback: it adds no extra
        health penalty beyond the dish''s normal calculation. Think about the ingredients
        and the overall meal, rather than treating a burst of energy as proof of
        a good result.'
  fingerprint: Ffdm1RRk33KiBXcyeCoBLwrrqlwPgsO8oBGRLMaSRNY=
